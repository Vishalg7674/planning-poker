{
  "name": "reveal",
  "version": "1.0.0",
  "private": true,
  "description": "Reveal — a uniquely designed, no-database planning poker app. Rooms live in server memory and vanish when everyone leaves.",
  "scripts": {
    "dev": "concurrently -k -n next,rt -c cyan,magenta \"npm:dev:next\" \"npm:dev:rt\"",
    "dev:next": "next dev",
    "dev:rt": "node server/index.mjs",
    "build": "next build",
    "start": "next start",
    "rt": "node server/index.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:realtime": "node scripts/e2e.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.0",
    "@reduxjs/toolkit": "^2.6.1",
    "@sentry/nextjs": "^10.70.0",
    "@sentry/node": "^10.70.0",
    "next": "^15.3.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "react-redux": "^9.2.0",
    "socket.io-client": "^4.8.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "sass": "^1.85.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
