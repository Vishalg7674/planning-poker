# ── Realtime server (server/index.mjs) ─────────────────────────────────────
# Port the Socket.io server listens on. Next.js runs on :3000 by default;
# the realtime server defaults to :3001 to sit next to it.
# Render/Railway inject a PORT env var; SOCKET_PORT wins when both are set.
SOCKET_PORT=3001

# Comma-separated list of origins allowed to open a WebSocket connection.
# Point this at wherever the Next.js app is served.
SOCKET_ORIGIN=http://localhost:3000

# ── Next.js app ────────────────────────────────────────────────────────────
# The WebSocket URL the browser connects to. Must match SOCKET_PORT and be
# reachable from the browser (so use your machine's LAN IP on real devices).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Optional: build the app into a separate output folder. The Playwright e2e
# suite sets NEXT_DIST_DIR=.next-e2e so its dev server never touches the
# `.next` cache used by `npm run dev`.
# NEXT_DIST_DIR=.next-e2e

# ── Ops (Phase 0 hardening — see optimization.md) ─────────────────────────
# Set to 1 to disable all socket rate limiting (test harnesses only).
# RATE_LIMIT_DISABLED=0

# Tune the in-memory buckets (defaults shown):
# RATE_LIMIT_CREATE_PER_MIN=5    room:create per IP per minute
# RATE_LIMIT_JOIN_PER_MIN=30     room:join per IP per minute
# RATE_LIMIT_VOTE_PER_SEC=10     vote:cast / game:* per socket per second
# MAX_SOCKETS_PER_IP=20          concurrent sockets per IP

# Read X-Forwarded-For when the realtime server sits behind a proxy/LB so
# rate limits and connection caps key on the real client IP, not the proxy.
# TRUST_PROXY=1

# pino log level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# ── Sentry error tracking (optional — leave unset to disable) ────────────
# The Next.js server runtime and the realtime server read SENTRY_DSN.
SENTRY_DSN=
# The browser bundle reads NEXT_PUBLIC_SENTRY_DSN (public by design — it is
# inlined into the client JS at build time).
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload during `next build` (optional, CI only — keep secret):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
